# Minimal module/test helpers for the replacement's downward native graph.
function(planar_native_target target)
  set_target_properties(${target} PROPERTIES CXX_MODULE_STD ON)
  target_compile_options(${target} PRIVATE -Wall -Wextra -Wpedantic)
  if(PLANAR_WARNINGS_AS_ERRORS)
    target_compile_options(${target} PRIVATE -Werror)
  endif()
endfunction()

# Explicit colocated test sources keep registration reviewable.
function(planar_rewrite_module name)
  cmake_parse_arguments(ARG "" "TEST_TIMEOUT" "INTERFACE;SOURCES;DEPENDS;TESTS" ${ARGN})
  add_library(${name} STATIC)
  set(module_base_dirs)
  foreach(interface IN LISTS ARG_INTERFACE)
    cmake_path(ABSOLUTE_PATH interface BASE_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}" OUTPUT_VARIABLE interface_path)
    cmake_path(GET interface_path PARENT_PATH interface_dir)
    list(APPEND module_base_dirs "${interface_dir}")
  endforeach()
  list(REMOVE_DUPLICATES module_base_dirs)
  target_sources(${name} PUBLIC FILE_SET CXX_MODULES BASE_DIRS ${module_base_dirs} FILES ${ARG_INTERFACE})
  target_sources(${name} PRIVATE ${ARG_SOURCES})
  target_link_libraries(${name} PUBLIC ${ARG_DEPENDS})
  planar_native_target(${name})
  if(ARG_TESTS)
    add_executable(${name}_tests EXCLUDE_FROM_ALL ${ARG_TESTS})
    planar_native_target(${name}_tests)
    target_link_libraries(${name}_tests PRIVATE ${name} Catch2::Catch2WithMain)
    add_dependencies(planar_tests ${name}_tests)
    if(NOT ARG_TEST_TIMEOUT)
      set(ARG_TEST_TIMEOUT 30)
    endif()
    catch_discover_tests(${name}_tests TEST_PREFIX "replacement." PROPERTIES LABELS unit TIMEOUT ${ARG_TEST_TIMEOUT})
  endif()
endfunction()
