[
  {
    "name": "cli",
    "argv": [
      "ctest",
      "--test-dir",
      "build/rewrite-debug",
      "-R",
      "^replacement.cli$",
      "-V",
      "--output-junit",
      "../../tests/native/r14b1-review-evidence/cli.xml"
    ],
    "exit": 0
  },
  {
    "name": "vectors",
    "argv": [
      "python3",
      "tests/vectors/generate.py",
      "--check"
    ],
    "exit": 0
  },
  {
    "name": "record-vectors",
    "argv": [
      "python3",
      "tests/vectors/records/generate.py",
      "--check"
    ],
    "exit": 0
  },
  {
    "name": "lint",
    "argv": [
      "python3",
      "scripts/rewrite-check.py",
      "lint",
      "--build-dir",
      "build/rewrite-debug"
    ],
    "exit": 0
  },
  {
    "name": "no-work",
    "argv": [
      "cmake",
      "--build",
      "build/rewrite-debug",
      "--target",
      "all",
      "planar_tests"
    ],
    "exit": 0
  }
]
