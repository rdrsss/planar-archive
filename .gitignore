# Build products and local historical outputs; no source build installs here.
/build/
/bin/
/dist/
*.o
*.obj
*.a
*.lib
/compile_commands.json
/doxygen-lint-output/

# Local agent settings and caches are not authored product surfaces.
.claude/
.codex/
.copilot/
.cache/
.pytest_cache/
__pycache__/
.worktrees/

# Operator scratch data, never product inputs discovered implicitly.
*.db
*.db-journal
*.db-wal
*.db-shm

# Editor and OS clutter.
.DS_Store
*.swp
*.swo
.idea/
.vscode/

# Round evidence is committed selectively: each folder's REPORT.md/README.md and
# small top-level .md/.json manifests (<=100 KB). Bulky artifacts stay local; the
# committed manifests record their hashes. Add new reports with `git add -f`.
/tests/native/*-evidence/
